<%- include('layout', { body: `
  <div class="row">
    <div class="col-md-4 text-center">
      <img src="<%= profileUser.avatar %>" class="rounded-circle mb-3" width="120" height="120" />
      <h3>@<%= profileUser.username %></h3>
      <p class="text-muted"><%= profileUser.bio || "No bio yet." %></p>
      <p>
        <strong><%= profileUser.followers.length %></strong> followers •
        <strong><%= profileUser.following.length %></strong> following
      </p>
      <% if (!isMe) { %>
        <form action="/profile/<%= profileUser.username %>/follow" method="POST">
          <button class="btn btn-sm <%= isFollowing ? 'btn-outline-secondary' : 'btn-primary' %>">
            <%= isFollowing ? 'Unfollow' : 'Follow' %>
          </button>
        </form>
        <a href="/messages/<%= profileUser.username %>" class="btn btn-sm btn-outline-primary mt-2">Message</a>
      <% } else { %>
        <a href="/settings/profile" class="btn btn-sm btn-outline-secondary">Edit profile</a>
      <% } %>
    </div>
    <div class="col-md-8">
      <h4 class="mb-3">Posts</h4>
      <% posts.forEach(post => { %>
        <div class="card mb-3">
          <div class="card-body">
            <% if (post.image) { %>
              <img src="<%= post.image %>" class="img-fluid rounded mb-2" />
            <% } %>
            <p><%= post.content %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
` }) %>

// =======================
// src/views/settings_profile.ejs
// =======================
<%- include('layout', { body: `
  <div class="row">
    <div class="col-md-6 mx-auto">
      <h3 class="mb-3">Edit profile</h3>
      <form action="/settings/profile" method="POST">
        <div class="mb-3">
          <label class="form-label">Avatar URL</label>
          <input type="text" name="avatar" class="form-control" value="<%= me.avatar %>" />
        </div>
        <div class="mb-3">
          <label class="form-label">Bio</label>
          <textarea name="bio" class="form-control" rows="3"><%= me.bio %></textarea>
        </div>
        <button class="btn btn-primary">Save</button>
      </form>
    </div>
  </div>
` }) %>

// =======================
// src/views/messages.ejs
// =======================
<%- include('layout', { body: `
  <div class="row">
    <div class="col-md-3">
      <h5>Chats</h5>
      <ul class="list-group">
        <% users.forEach(u => { %>
          <a href="/messages/<%= u.username %>" class="list-group-item list-group-item-action <%= activeUser && activeUser.username === u.username ? 'active' : '' %>">
            <img src="<%= u.avatar %>" class="rounded-circle me-2" width="24" height="24" />
            @<%= u.username %>
          </a>
        <% }) %>
      </ul>
    </div>
    <div class="col-md-9">
      <% if (!activeUser) { %>
        <p class="text-muted">Select a user to start chatting.</p>
      <% } else { %>
        <h5>Chat with @<%= activeUser.username %></h5>
        <div class="border rounded p-2 mb-2 chat-thread">
          <% thread.forEach(m => { %>
            <div class="mb-1">
              <strong>@<%= m.from.username %>:</strong> <%= m.content %>
              <span class="text-muted small"> • <%= new Date(m.createdAt).toLocaleTimeString() %></span>
            </div>
          <% }) %>
        </div>
        <form action="/messages/<%= activeUser.username %>" method="POST">
          <div class="input-group">
            <input type="text" name="content" class="form-control" placeholder="Type a message..." />
            <button class="btn btn-primary">Send</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
` }) %>

// =======================
// src/views/notifications.ejs
// =======================
<%- include('layout', { body: `
  <h3 class="mb-3">Notifications</h3>
  <% if (list.length === 0) { %>
    <p class="text-muted">No notifications.</p>
  <% } else { %>
    <ul class="list-group">
      <% list.forEach(n => { %>
        <li class="list-group-item">
          <% if (n.fromUser) { %>
            <img src="<%= n.fromUser.avatar %>" class="rounded-circle me-2" width="24" height="24" />
            <strong>@<%= n.fromUser.username %></strong>:
          <% } %>
          <%= n.message %>
          <span class="text-muted small"> • <%= new Date(n.createdAt).toLocaleString() %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
` }) %>

