// =======================
// server.js
// =======================
const express = require('express');
const mongoose = require('mongoose');
const session = require('express-session');
const MongoStore = require('connect-mongo');
const methodOverride = require('method-override');
const path = require('path');
const dotenv = require('dotenv');

dotenv.config();

const User = require('./src/models/User');
const Post = require('./src/models/Post');
const Comment = require('./src/models/Comment');
const Message = require('./src/models/Message');
const Story = require('./src/models/Story');
const Notification = require('./src/models/Notification');
const upload = require('./src/middleware/upload');
const bcrypt = require('bcrypt');

const app = express();

// ---------- DB ----------
mongoose
  .connect(process.env.MONGO_URI)
  .then(() => console.log('MongoDB connected'))
  .catch(err => console.error(err));

// ---------- Middleware ----------
app.set('view engine', 'ejs');
app.set('views', path.join(__dirname, 'src', 'views'));

app.use(express.urlencoded({ extended: true }));
app.use(express.static(path.join(__dirname, 'public')));
app.use(methodOverride('_method'));

app.use(
  session({
    secret: process.env.SESSION_SECRET || 'keyboardcat',
    resave: false,
    saveUninitialized: false,
    store: MongoStore.create({ mongoUrl: process.env.MONGO_URI }),
    cookie: { maxAge: 1000 * 60 * 60 * 24 * 7 }
  })
);

// ---------- Auth helpers ----------
function requireAuth(req, res, next) {
  if (!req.session.userId) return res.redirect('/login');
  next();
}

app.use(async (req, res, next) => {
  res.locals.currentUser = null;
  if (req.session.userId) {
    try {
      const user = await User.findById(req.session.userId);
      res.locals.currentUser = user;
    } catch (e) {}
  }
  next();
});

// ---------- Routes ----------

// Home feed (posts from self + following)
app.get('/', requireAuth, async (req, res) => {
  const me = await User.findById(req.session.userId);
  const ids = [me._id, ...me.following];
  const posts = await Post.find({ author: { $in: ids } })
    .populate('author', 'username avatar')
    .sort({ createdAt: -1 });

  const stories = await Story.find({
    author: { $in: ids },
    expiresAt: { $gt: new Date() }
  })
    .populate('author', 'username avatar')
    .sort({ createdAt: -1 });

  const notifications = await Notification.find({ user: me._id, read: false })
    .sort({ createdAt: -1 })
    .limit(10);

  res.render('index', { posts, stories, notifications });
});

// Explore (all posts)
app.get('/explore', requireAuth, async (req, res) => {
  const posts = await Post.find()
    .populate('author', 'username avatar')
    .sort({ createdAt: -1 });
  res.render('explore', { posts });
});

// Register
app.get('/register', (req, res) => {
  if (req.session.userId) return res.redirect('/');
  res.render('register', { error: null });
});

app.post('/register', async (req, res) => {
  const { username, email, password, confirmPassword } = req.body;
  if (!username || !email || !password || !confirmPassword) {
    return res.render('register', { error: 'All fields required' });
  }
  if (password !== confirmPassword) {
    return res.render('register', { error: 'Passwords do not match' });
  }
  const existing = await User.findOne({ $or: [{ email }, { username }] });
  if (existing) {
    return res.render('register', { error: 'User already exists' });
  }
  const hashed = await bcrypt.hash(password, 10);
  const user = await User.create({ username, email, password: hashed });
  req.session.userId = user._id;
  res.redirect('/');
});

// Login
app.get('/login', (req, res) => {
  if (req.session.userId) return res.redirect('/');
  res.render('login', { error: null });
});

app.post('/login', async (req, res) => {
  const { emailOrUsername, password } = req.body;
  if (!emailOrUsername || !password) {
    return res.render('login', { error: 'All fields required' });
  }
  const user = await User.findOne({
    $or: [{ email: emailOrUsername }, { username: emailOrUsername }]
  });
  if (!user) return res.render('login', { error: 'Invalid credentials' });
  const match = await bcrypt.compare(password, user.password);
  if (!match) return res.render('login', { error: 'Invalid credentials' });
  req.session.userId = user._id;
  res.redirect('/');
});

// Logout
app.post('/logout', (req, res) => {
  req.session.destroy(() => res.redirect('/login'));
});

// Profile
app.get('/profile/:username', requireAuth, async (req, res) => {
  const profileUser = await User.findOne({ username: req.params.username });
  if (!profileUser) return res.status(404).send('User not found');

  const posts = await Post.find({ author: profileUser._id }).sort({ createdAt: -1 });
  const isMe = profileUser._id.toString() === req.session.userId.toString();
  const me = await User.findById(req.session.userId);
  const isFollowing = me.following.map(id => id.toString()).includes(profileUser._id.toString());

  res.render('profile', { profileUser, posts, isMe, isFollowing });
});

// Follow / unfollow
app.post('/profile/:username/follow', requireAuth, async (req, res) => {
  const target = await User.findOne({ username: req.params.username });
  if (!target) return res.redirect('back');
  const me = await User.findById(req.session.userId);

  const already = me.following.map(id => id.toString()).includes(target._id.toString());
  if (already) {
    me.following = me.following.filter(id => id.toString() !== target._id.toString());
    target.followers = target.followers.filter(id => id.toString() !== me._id.toString());
  } else {
    me.following.push(target._id);
    target.followers.push(me._id);
    await Notification.create({
      user: target._id,
      type: 'follow',
      fromUser: me._id,
      message: `${me.username} started following you`
    });
  }
  await me.save();
  await target.save();
  res.redirect('back');
});

// Edit profile (bio + avatar URL only, to keep simple)
app.get('/settings/profile', requireAuth, async (req, res) => {
  const me = await User.findById(req.session.userId);
  res.render('settings_profile', { me, error: null });
});

app.post('/settings/profile', requireAuth, async (req, res) => {
  const { bio, avatar } = req.body;
  const me = await User.findById(req.session.userId);
  me.bio = bio || '';
  if (avatar && avatar.trim()) me.avatar = avatar.trim();
  await me.save();
  res.redirect(`/profile/${me.username}`);
});

// Create post (with optional image)
app.post('/posts', requireAuth, upload.single('image'), async (req, res) => {
  const { content } = req.body;
  if (!content && !req.file) return res.redirect('back');
  const post = await Post.create({
    author: req.session.userId,
    content: content || '',
    image: req.file ? '/uploads/' + req.file.filename : null
  });

  // Notify followers
  const me = await User.findById(req.session.userId);
  const followers = me.followers || [];
  await Promise.all(
    followers.map(fid =>
      Notification.create({
        user: fid,
        type: 'post',
        fromUser: me._id,
        post: post._id,
        message: `${me.username} posted something`
      })
    )
  );

  res.redirect('/');
});

// Like / unlike post
app.post('/posts/:id/like', requireAuth, async (req, res) => {
  const post = await Post.findById(req.params.id).populate('author');
  if (!post) return res.redirect('back');
  const userId = req.session.userId.toString();
  const hasLiked = post.likes.map(id => id.toString()).includes(userId);
  if (hasLiked) {
    post.likes = post.likes.filter(id => id.toString() !== userId);
  } else {
    post.likes.push(userId);
    if (post.author._id.toString() !== userId) {
      await Notification.create({
        user: post.author._id,
        type: 'like',
        fromUser: userId,
        post: post._id,
        message: `${(await User.findById(userId)).username} liked your post`
      });
    }
  }
  await post.save();
  res.redirect('back');
});

// Comments
app.post('/posts/:id/comments', requireAuth, async (req, res) => {
  const { content } = req.body;
  if (!content || !content.trim()) return res.redirect('back');
  const post = await Post.findById(req.params.id).populate('author');
  if (!post) return res.redirect('back');

  const comment = await Comment.create({
    post: post._id,
    author: req.session.userId,
    content: content.trim()
  });

  if (post.author._id.toString() !== req.session.userId.toString()) {
    await Notification.create({
      user: post.author._id,
      type: 'comment',
      fromUser: req.session.userId,
      post: post._id,
      message: `${(await User.findById(req.session.userId)).username} commented on your post`
    });
  }

  res.redirect('back');
});

// Stories (24h)
app.post('/stories', requireAuth, upload.single('image'), async (req, res) => {
  const { caption } = req.body;
  if (!req.file) return res.redirect('back');
  const now = new Date();
  const expiresAt = new Date(now.getTime() + 24 * 60 * 60 * 1000);
  await Story.create({
    author: req.session.userId,
    image: '/uploads/' + req.file.filename,
    caption: caption || '',
    expiresAt
  });
  res.redirect('/');
});

// Messages (simple 1:1)
app.get('/messages', requireAuth, async (req, res) => {
  const me = await User.findById(req.session.userId);
  const users = await User.find({ _id: { $ne: me._id } }).select('username avatar');
  res.render('messages', { users, activeUser: null, thread: [] });
});

app.get('/messages/:username', requireAuth, async (req, res) => {
  const me = await User.findById(req.session.userId);
  const other = await User.findOne({ username: req.params.username });
  if (!other) return res.redirect('/messages');

  const users = await User.find({ _id: { $ne: me._id } }).select('username avatar');

  const thread = await Message.find({
    $or: [
      { from: me._id, to: other._id },
      { from: other._id, to: me._id }
    ]
  })
    .populate('from', 'username avatar')
    .populate('to', 'username avatar')
    .sort({ createdAt: 1 });

  res.render('messages', { users, activeUser: other, thread });
});

app.post('/messages/:username', requireAuth, async (req, res) => {
  const me = await User.findById(req.session.userId);
  const other = await User.findOne({ username: req.params.username });
  if (!other) return res.redirect('/messages');
  const { content } = req.body;
  if (!content || !content.trim()) return res.redirect('back');

  await Message.create({
    from: me._id,
    to: other._id,
    content: content.trim()
  });

  await Notification.create({
    user: other._id,
    type: 'message',
    fromUser: me._id,
    message: `New message from ${me.username}`
  });

  res.redirect('back');
});

// Notifications page
app.get('/notifications', requireAuth, async (req, res) => {
  const list = await Notification.find({ user: req.session.userId })
    .populate('fromUser', 'username avatar')
    .populate('post', '_id')
    .sort({ createdAt: -1 })
    .limit(50);
  await Notification.updateMany({ user: req.session.userId, read: false }, { read: true });
  res.render('notifications', { list });
});

// 404
app.use((req, res) => res.status(404).send('Not found'));

// Start
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`http://localhost:${PORT}`));

// =======================
// src/models/User.js
// =======================
const mongoose = require('mongoose');

const userSchema = new mongoose.Schema(
  {
    username: { type: String, required: true, unique: true, trim: true },
    email: { type: String, required: true, unique: true, lowercase: true },
    password: { type: String, required: true },
    bio: { type: String, default: '' },
    avatar: { type: String, default: '/default-avatar.png' },
    followers: [{ type: mongoose.Schema.Types.ObjectId, ref: 'User' }],
    following: [{ type: mongoose.Schema.Types.ObjectId, ref: 'User' }]
  },
  { timestamps: true }
);

module.exports = mongoose.model('User', userSchema);

// =======================
// src/models/Post.js
// =======================
const mongoose2 = require('mongoose');

const postSchema = new mongoose2.Schema(
  {
    author: { type: mongoose2.Schema.Types.ObjectId, ref: 'User', required: true },
    content: { type: String, default: '' },
    image: { type: String, default: null },
    likes: [{ type: mongoose2.Schema.Types.ObjectId, ref: 'User' }]
  },
  { timestamps: true }
);

module.exports = mongoose2.model('Post', postSchema);

// =======================
// src/models/Comment.js
// =======================
const mongoose3 = require('mongoose');

const commentSchema = new mongoose3.Schema(
  {
    post: { type: mongoose3.Schema.Types.ObjectId, ref: 'Post', required: true },
    author: { type: mongoose3.Schema.Types.ObjectId, ref: 'User', required: true },
    content: { type: String, required: true }
  },
  { timestamps: true }
);

module.exports = mongoose3.model('Comment', commentSchema);

// =======================
// src/models/Message.js
// =======================
const mongoose4 = require('mongoose');

const messageSchema = new mongoose4.Schema(
  {
    from: { type: mongoose4.Schema.Types.ObjectId, ref: 'User', required: true },
    to: { type: mongoose4.Schema.Types.ObjectId, ref: 'User', required: true },
    content: { type: String, required: true }
  },
  { timestamps: true }
);

module.exports = mongoose4.model('Message', messageSchema);

// =======================
// src/models/Story.js
// =======================
const mongoose5 = require('mongoose');

const storySchema = new mongoose5.Schema(
  {
    author: { type: mongoose5.Schema.Types.ObjectId, ref: 'User', required: true },
    image: { type: String, required: true },
    caption: { type: String, default: '' },
    expiresAt: { type: Date, required: true }
  },
  { timestamps: true }
);

module.exports = mongoose5.model('Story', storySchema);

// =======================
// src/models/Notification.js
// =======================
const mongoose6 = require('mongoose');

const notificationSchema = new mongoose6.Schema(
  {
    user: { type: mongoose6.Schema.Types.ObjectId, ref: 'User', required: true },
    type: { type: String, enum: ['follow', 'like', 'comment', 'post', 'message'], required: true },
    fromUser: { type: mongoose6.Schema.Types.ObjectId, ref: 'User' },
    post: { type: mongoose6.Schema.Types.ObjectId, ref: 'Post' },
    message: { type: String, required: true },
    read: { type: Boolean, default: false }
  },
  { timestamps: true }
);

module.exports = mongoose6.model('Notification', notificationSchema);

// =======================
// src/middleware/upload.js
// =======================
const multer = require('multer');
const path = require('path');
const fs = require('fs');

const uploadDir = path.join(__dirname, '..', '..', 'public', 'uploads');
if (!fs.existsSync(uploadDir)) fs.mkdirSync(uploadDir, { recursive: true });

const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, uploadDir),
  filename: (req, file, cb) =>
    cb(null, Date.now() + '-' + Math.round(Math.random() * 1e9) + path.extname(file.originalname))
});

module.exports = multer({ storage });

